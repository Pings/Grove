# Optional: you can also paste the key in Settings (preferred).
# VITE_GEMINI_API_KEY=

# Host ports (keep these in .env so git auto-update does not overwrite them)
XIN_PORT=8081
SYNC_PORT=8090

# Cloudflare Tunnel (optional — public HTTPS without opening ports)
# 1. Zero Trust → Networks → Tunnels → Create tunnel → copy token
# 2. Add a Public Hostname: your domain → http://xin:80
# 3. Set profiles + token, redeploy in Dockge
# COMPOSE_PROFILES=cloudflare,watcher
# TUNNEL_TOKEN=

TUNNEL_TOKEN=

# Deploy watcher — polls origin/main and rebuilds xin + xin-sync (not cloudflared/watcher)
# COMPOSE_PROFILES must include "watcher"
DEPLOY_HOST_PATH=/mnt/Maru/Apps/Dockge/stacks/xin
DEPLOY_BRANCH=main
POLL_SECONDS=60
# Optional private-repo key path inside the watcher container:
# DEPLOY_SSH_KEY=/run/secrets/deploy_key
