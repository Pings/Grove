# Optional: you can also paste the key in Settings (preferred).
# VITE_GEMINI_API_KEY=

# Host ports (keep these in .env so git auto-update does not overwrite them)
GROVE_PORT=8081
SYNC_PORT=8090

# Cloudflare Tunnel (optional — public HTTPS without opening ports)
# 1. Zero Trust → Networks → Tunnels → Create tunnel → copy token
# 2. Add a Public Hostname: your domain → http://grove:80
# 3. Uncomment / set the lines below, redeploy in Dockge
# COMPOSE_PROFILES=cloudflare
# TUNNEL_TOKEN=

# Always fine to leave blank (avoids compose warnings when tunnel is off)
TUNNEL_TOKEN=
